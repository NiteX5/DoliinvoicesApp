# ============================================================
# Facturas SSP — Variables de entorno (EJEMPLO)
# ============================================================
#
# Este archivo documenta las variables de configuración disponibles.
# La app las lee en TIEMPO DE COMPILACIÓN mediante --dart-define,
# por lo que este archivo no se carga automáticamente en Flutter.
#
# Para usar los valores, pásalos al comando de ejecución:
#
#   flutter run \
#     --dart-define=DOLIBARR_BASE_URL=https://tudominio.com/dolibarr/api/index.php \
#     --dart-define=GEMINI_API_KEY=tu_api_key_gemini \
#     --dart-define=DOLIBARR_BANK_ACCOUNT_REF=REF_BANCO
#
# ⚠️ NUNCA subas valores reales al repositorio.
# Copia este archivo a .env y rellena tus propios datos; .env está en .gitignore.

# ------------------------------------------------------------------
# Dolibarr ERP
# ------------------------------------------------------------------

# URL base de la API REST de Dolibarr. Debe apuntar al index.php de la API:
#   https://tudominio.com/dolibarr/api/index.php
# En tiempo de ejecución también se puede configurar desde SharedPreferences
# (el valor guardado tiene prioridad sobre este).
DOLIBARR_BASE_URL=https://tudominio.com/dolibarr/api/index.php

# Referencia (ref, label o number) de la cuenta bancaria preferida de Dolibarr
# que se usará al registrar pagos de facturas de proveedores.
# Si se deja vacío, se utiliza la primera cuenta activa de Dolibarr.
DOLIBARR_BANK_ACCOUNT_REF=

# ------------------------------------------------------------------
# Google Gemini AI (OCR + extracción de datos de facturas)
# ------------------------------------------------------------------

# API Key de Google Generative Language (Gemini). Se obtiene en:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_gemini

# ------------------------------------------------------------------
# Android — applicationId (se configura en android/local.properties,
# NO en este archivo)
# ------------------------------------------------------------------
#   flutter.applicationId=com.tuempresa.app
# Si no se define, la app usa el valor por defecto: com.facturas_ssp.app
